msg db "ok", 10
unused_fn:
    mov eax, 5
    ret
tiny:
    inc eax
    add eax, 2
    ret
helper:
    mov eax, 7
    jmp helper2
helper2:
    ret
start:
    mov eax, 0
    mov rbx, 0
    mov ecx, 0
    cmp ecx, 0
    jne bad
    call tiny
    add ecx, 1
    cmp ecx, 1
    jbe bad
    call helper
    jmp next
    mov eax, 99
next:
    mov rsi, msg
    mov [rsp-8], rsi
    mov rsi, [rsp-8]
    mov rax, 1
    mov rdi, 1
    mov rdx, 3
    syscall
    jz skip
    jmp done
skip:
    nop
done:
    mov rax, 60
    mov rdi, 0
    syscall
bad:
    mov rax, 60
    mov rdi, 1
    syscall
